rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function normalizedRole() {
      return hasUserDoc() && userDoc().keys().hasAll(['role'])
        && userDoc().role is string
        ? userDoc().role.lower()
        : '';
    }

    function isActiveUser() {
      return hasUserDoc()
        && userDoc().keys().hasAll(['status'])
        && userDoc().status is string
        && userDoc().status.lower() == 'active';
    }

    function isAdmin() {
      return isActiveUser()
        && normalizedRole() in ['admin', 'administrator'];
    }

    function isStaffOrAdmin() {
      return isActiveUser()
        && normalizedRole() in ['admin', 'administrator', 'staff'];
    }

    function profileSelfUpdateKeysAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'firstName', 'middleName', 'lastName', 'phone', 'address',
        'birthday', 'gender', 'photoURL', 'updatedAt', 'updatedBy', 'lastLogin',
        'lastPasswordChange'
      ]);
    }

    // Users may read/update only their own profile document.
    // Role, email, status, and privilege fields cannot be changed by self-update.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (
          isOwner(userId)
          && profileSelfUpdateKeysAllowed()
          && (!('role' in request.resource.data)
            || request.resource.data.role == resource.data.role)
          && (!('email' in request.resource.data)
            || request.resource.data.email == resource.data.email)
          && (!('status' in request.resource.data)
            || request.resource.data.status == resource.data.status)
        );
      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isStaffOrAdmin()
        && request.resource.data.performedByUid == request.auth.uid
        && request.resource.data.keys().hasAll([
          'action', 'module', 'performedBy', 'performedByUid', 'timestamp'
        ]);
      allow update, delete: if false;
    }

    function canDeleteOperationalRecord(collection) {
      return (collection == 'massIntentions'
          && !(resource.data.get('status', '') is string
            && resource.data.get('status', '').lower() in ['offered', 'cancelled']))
        || collection == 'events';
    }

    function validArchiveUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let archiveKeys = ['archived', 'archivedAt', 'archiveReason', 'recoveredAt', 'recoveryReason'];
      let archiveChanged = changed.hasAny(archiveKeys);
      let isArchive = resource.data.get('archived', false) != true
        && request.resource.data.get('archived', false) == true;
      let isRecovery = resource.data.get('archived', false) == true
        && request.resource.data.get('archived', false) == false;
      return (!archiveChanged && resource.data.get('archived', false) != true)
        || (changed.hasOnly(archiveKeys)
          && ((isArchive
              && request.resource.data.archiveReason is string
              && request.resource.data.archiveReason.matches('.*\\S.*')
              && request.resource.data.archivedAt is timestamp)
            || (isRecovery
              && request.resource.data.recoveryReason is string
              && request.resource.data.recoveryReason.matches('.*\\S.*')
              && request.resource.data.recoveredAt is timestamp)));
    }

    function validMassIntentionStatus() {
      return request.resource.data.get('status', 'Pending')
        in ['Pending', 'Scheduled', 'Offered', 'Cancelled'];
    }

    // Parish operational collections — staff/admin only (matches UI guards).
    match /{collection}/{docId} {
      allow read: if isStaffOrAdmin()
        && collection in [
          'baptism', 'confirmation', 'marriage', 'death', 'conversion',
          'massIntentions', 'events', 'ministers', 'reports'
        ];
      allow create: if isStaffOrAdmin()
        && collection in [
          'baptism', 'confirmation', 'marriage', 'death', 'conversion',
          'massIntentions', 'events', 'ministers', 'reports'
        ]
        && (!(collection in ['baptism', 'confirmation', 'marriage', 'death', 'conversion'])
          || request.resource.data.get('archived', false) != true)
        && (collection != 'massIntentions' || validMassIntentionStatus());
      allow update: if isStaffOrAdmin()
        && collection in [
          'baptism', 'confirmation', 'marriage', 'death', 'conversion',
          'massIntentions', 'events', 'ministers', 'reports'
        ]
        && (collection != 'massIntentions'
          || (validMassIntentionStatus()
            && !(resource.data.get('status', '') is string
              && resource.data.get('status', '').lower() in ['offered', 'cancelled'])))
        && (collection != 'events'
          || (resource.data.get('source', 'manual')
              == request.resource.data.get('source', 'manual')
            && resource.data.get('relatedRecordId', null)
              == request.resource.data.get('relatedRecordId', null)))
        && (!(collection in ['baptism', 'confirmation', 'marriage', 'death', 'conversion'])
          || validArchiveUpdate());
      allow delete: if isStaffOrAdmin()
        && canDeleteOperationalRecord(collection);
    }
  }
}
